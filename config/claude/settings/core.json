{
  "teammateMode": "in-process",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(claude --bg *)",
      "Bash(claude --background *)",
      "Bash(claude agents*)",
      "Bash(claude logs *)"
    ],
    "deny": [
      "Bash(claude stop *)",
      "Bash(claude kill *)",
      "Bash(claude rm *)"
    ]
  }
}
