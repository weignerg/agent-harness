{
  "teammateMode": "in-process",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": [
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(systemctl stop *)",
      "Bash(systemctl --user stop *)",
      "Bash(claude stop *)",
      "Bash(claude kill *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue close *)"
    ]
  }
}
