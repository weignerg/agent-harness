[Unit]
Description=SGLang Llama-3.3-70B Profile Template
After=network.target

[Service]
Type=exec
EnvironmentFile=-%h/.config/opencode-backends/env
Environment="CUDA_HOME=/opt/cuda"
Environment="PATH=/opt/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
Environment="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
ExecStart=%h/.local/share/opencode-sglang-stack/venv/bin/sglang serve \
  --sleep-on-idle \
  --tool-call-parser llama3 \
  --model-path RedHatAI/llama-3.3-70b-instruct-nvfp4 \
  --quantization compressed-tensors \
  --prefill-attention-backend flashinfer \
  --decode-attention-backend flashinfer \
  --kv-cache-dtype nvfp4 \
  --mem-fraction-static 0.94 \
  --context-length 16384 \
  --chunked-prefill-size 2048 \
  --max-running-requests 1 \
  --port 36921 \
  --host 127.0.0.1

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
