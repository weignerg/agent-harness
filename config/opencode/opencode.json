{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-sglang": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local SGLang",
      "options": {
        "baseURL": "http://127.0.0.1:30000/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "ornith-1.5-35b": {
          "name": "Ornith 1.5 35B-A3B",
          "context": 262144,
          "output": 32768,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "ornith-1.5-9b": {
          "name": "Ornith 1.5 9B",
          "context": 262144,
          "output": 32768,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B",
          "context": 131072,
          "output": 32768,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "thinkingBudget": 16384
            },
            "medium": {
              "reasoningEffort": "medium",
              "thinkingBudget": 8192
            },
            "low": {
              "reasoningEffort": "low",
              "thinkingBudget": 4096
            }
          }
        }
      }
    },
    "ornith-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ornith Local",
      "options": {
        "baseURL": "http://127.0.0.1:30000/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "ornith-1.5-35b": {
          "name": "Ornith 1.5 35B-A3B"
        },
        "ornith-1.5-9b": {
          "name": "Ornith 1.5 9B"
        },
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B"
        }
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic Claude",
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-3-7-sonnet": {
          "name": "Claude 3.7 Sonnet"
        },
        "claude-3-5-haiku": {
          "name": "Claude 3.5 Haiku"
        }
      }
    },
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google Gemini",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        }
      }
    }
  },
  "mcp": {
    "vault-memory": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "PY=\"${HOME}/.local/share/opencode-sglang-stack/venv/bin/python\"; if [ ! -x \"$PY\" ]; then PY=\"python3\"; fi; exec \"$PY\" -m harness.mcp.vault_server"
      ],
      "environment": {
        "ORCHESTRATION_ROOT": "{env:ORCHESTRATION_ROOT}",
        "PYTHONPATH": "{env:PYTHONPATH}"
      },
      "enabled": true
    },
    "worktree-manager": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "PY=\"${HOME}/.local/share/opencode-sglang-stack/venv/bin/python\"; if [ ! -x \"$PY\" ]; then PY=\"python3\"; fi; exec \"$PY\" -m harness.mcp.worktree_server"
      ],
      "environment": {
        "ORCHESTRATION_ROOT": "{env:ORCHESTRATION_ROOT}",
        "PYTHONPATH": "{env:PYTHONPATH}"
      },
      "enabled": true
    }
  },
  "instructions": [
    ".opencode/rules/*.md"
  ],
  "model": "ornith-local/ornith-1.5-35b",
  "default_agent": "supreme-orchestrator",
  "subagent_depth": 3,
  "small_model": "ornith-local/ornith-1.5-9b",
  "permission": {
    "bash": {
      "*": "allow",
      "kill *": "deny",
      "pkill *": "deny",
      "killall *": "deny",
      "systemctl stop *": "deny",
      "systemctl --user stop *": "deny",
      "claude stop *": "deny",
      "claude kill *": "deny",
      "git push*": "ask",
      "git merge*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr review*": "ask",
      "gh pr comment*": "ask",
      "gh issue create*": "ask",
      "gh issue close*": "ask",
      "gh issue comment*": "ask",
      "gh workflow run*": "ask"
    },
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "external_directory": "allow"
  },
  "agent": {
    "supreme-orchestrator": {
      "model": "ornith-local/ornith-1.5-35b",
      "description": "Single human-facing primary: triages requirements, awaits human agreement, then delegates to exactly one per-issue team-orchestrator; never spawns leaves, edits files, runs tests, or merges",
      "tools": {
        "question": true
      },
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "git commit*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny"
        },
        "task": {
          "*": "deny",
          "team-orchestrator": "allow"
        }
      }
    },
    "team-orchestrator": {
      "model": "ornith-local/ornith-1.5-35b",
      "description": "Per-issue team orchestrator: plans, awaits approval, then dispatches and coordinates the agent team; the only agent allowed to spawn leaves; never merges",
      "tools": {
        "question": true
      },
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "git commit*": "deny",
          "git merge*": "deny"
        },
        "task": {
          "*": "deny",
          "architect": "allow",
          "worker": "allow",
          "tester": "allow",
          "reviewer": "allow",
          "scout": "allow",
          "grunt": "allow"
        }
      }
    },
    "architect": {
      "model": "ornith-local/ornith-1.5-35b",
      "description": "Subsystem design, codebase surveys, high-context refactor blueprints, and dependency topology; calls scout for searches",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "git commit*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny"
        },
        "task": {
          "*": "deny",
          "scout": "allow"
        }
      }
    },
    "worker": {
      "model": "ornith-local/ornith-1.5-35b",
      "description": "Implementation, refactoring, test authoring, and commits; calls grunt and scout",
      "permission": {
        "task": {
          "*": "deny",
          "grunt": "allow",
          "scout": "allow"
        }
      }
    },
    "tester": {
      "model": "ornith-local/ornith-1.5-35b",
      "description": "Runs the TDD pipeline, fixes failures, and verifies behavior; calls grunt and scout",
      "permission": {
        "task": {
          "*": "deny",
          "grunt": "allow",
          "scout": "allow"
        }
      }
    },
    "reviewer": {
      "model": "ornith-local/ornith-1.5-35b",
      "description": "Adversarial code reviewer and security gatekeeper; calls scout only for searches",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "git commit*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny"
        },
        "task": {
          "*": "deny",
          "scout": "allow"
        }
      }
    },
    "scout": {
      "model": "ornith-local/ornith-1.5-9b",
      "description": "Read-only 9B search subagent: grep, file discovery, large-scale context consolidation",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "bash": {
          "git commit*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny"
        }
      }
    },
    "grunt": {
      "model": "ornith-local/ornith-1.5-9b",
      "description": "9B leaf subagent: atomic simple edits, localized checks, small searches",
      "permission": {
        "task": "deny"
      }
    },
    "summary": {
      "model": "ornith-local/ornith-1.5-9b",
      "description": "Commit summary and change log synthesis"
    },
    "compaction": {
      "model": "ornith-local/ornith-1.5-9b",
      "description": "Conversation context compaction and pruning"
    }
  }
}
